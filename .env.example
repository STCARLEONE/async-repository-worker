# Worker Pool
WORKER_COUNT=4
JOB_TIMEOUT=30.0
SHUTDOWN_TIMEOUT=10.0

# Queue
QUEUE_MAX_SIZE=1000

# Rate Limiter
RATE_LIMIT=5.0
RATE_CAPACITY=5

# Retry Policy
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=30.0
RETRY_JITTER=true

# GitHub API
GITHUB_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT=30.0
GITHUB_MAX_RETRIES=3

# Database / Cache
DATA_DIR=./data
DATABASE_PATH=./data/repositories.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Observability
ENABLE_METRICS=true

# GitHub Token (Required for API calls)
GITHUB_TOKEN=your_github_token_here